---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../lib/site";
---
<BaseLayout>
  <section id="signal" class="container section">
    <div class="reveal grid lg:grid-cols-[1.15fr_0.85fr] gap-10 items-center">
      <div class="flex flex-col gap-8">
      <span class="kicker">The Signal</span>
      <h1 class="serif text-4xl sm:text-6xl leading-tight">
        Strategy isn't a slide deck. It's the bridge between product and people.
      </h1>
      <p class="text-lg sm:text-xl text-[color:var(--muted)] max-w-2xl">
        I help real estate and media teams explain complex products in plain language.
      </p>
      <p class="text-base sm:text-lg max-w-2xl">
        I'm a real estate marketing strategist and product leader with 15+ years in platform
        rebuilds, UX, and launch work for Sotheby's International Realty, Bright MLS, WFG,
        Inman News, and 1000watt.
      </p>
      <ul class="grid gap-2 text-sm text-[color:var(--muted)] max-w-2xl">
        <li>Translate technical products into customer-friendly stories.</li>
        <li>Align teams on positioning, messaging, and rollout.</li>
        <li>Deliver digital experiences that feel premium and easy to use.</li>
      </ul>
      <div class="flex flex-wrap gap-4">
        <a class="btn btn-primary" href={SITE.ctaPrimary}>Schedule a Strategy Audit</a>
        <a class="btn" href={SITE.ctaSecondary}>Read the Daily Riff</a>
      </div>
      </div>
      <div class="flex justify-center lg:justify-end">
        <div class="portrait-frame">
          <img src="/joel.jpg" alt="Joel Burslem" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="ticker-wrap" aria-label="Trusted by">
    <div class="container">
      <span class="kicker">Trusted by</span>
      <div class="ticker">
        <div class="ticker-track">
      <span class="ticker-item">WFG</span>
      <span class="ticker-item">1000watt</span>
      <span class="ticker-item">Sotheby's</span>
      <span class="ticker-item">Bright MLS</span>
      <span class="ticker-item">Inman News</span>
      <span class="ticker-item">WFG</span>
      <span class="ticker-item">1000watt</span>
      <span class="ticker-item">Sotheby's</span>
      <span class="ticker-item">Bright MLS</span>
      <span class="ticker-item">Inman News</span>
        </div>
      </div>
    </div>
  </section>

  <section id="assets" class="container section grid gap-12">
    <div class="reveal grid gap-6">
      <span class="kicker">Distinctive Assets</span>
      <h2 class="serif text-3xl sm:text-4xl">Clear strategy, strong creative, measurable results.</h2>
      <p class="text-base sm:text-lg text-[color:var(--muted)] max-w-3xl">
        I translate complex product ecosystems into plain language and practical plans that help
        teams ship, sell, and scale.
      </p>
    </div>
    <div class="reveal grid sm:grid-cols-3 gap-6">
      <div class="p-6 rounded-2xl border border-[color:var(--line)] bg-[color:var(--bg-elev)]">
        <span class="tag">Brevity</span>
        <h3 class="serif text-2xl mt-4">Remarkable signals</h3>
        <p class="text-sm mt-3 text-[color:var(--muted)]">
          Short, punchy insights designed to create momentum and curiosity.
        </p>
      </div>
      <div class="p-6 rounded-2xl border border-[color:var(--line)] bg-[color:var(--bg-elev)]">
        <span class="tag">Rigor</span>
        <h3 class="serif text-2xl mt-4">Framework-backed moves</h3>
        <p class="text-sm mt-3 text-[color:var(--muted)]">
          Evidence of strategic systems and outcomes, not just opinions.
        </p>
      </div>
      <div class="p-6 rounded-2xl border border-[color:var(--line)] bg-[color:var(--bg-elev)]">
        <span class="tag">Clarity</span>
        <h3 class="serif text-2xl mt-4">Creative briefs, not jargon</h3>
        <p class="text-sm mt-3 text-[color:var(--muted)]">
          Every move explained with a clear narrative and an outcome.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
