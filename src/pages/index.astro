---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../lib/site";
---
<BaseLayout>
  <section id="signal" class="container section">
    <div class="reveal grid lg:grid-cols-[1.15fr_0.85fr] gap-10 items-center">
      <div class="flex flex-col gap-8">
      <span class="kicker">The Advantage</span>
      <h1 class="serif text-4xl sm:text-6xl leading-tight">
        Positioning that move products and people.
      </h1>
      <p class="text-lg sm:text-xl text-[color:var(--muted)] max-w-2xl">
        I help real estate and technology teams tell clearer stories, ship better products, and
        give sales and partners the tools they need to succeed.
      </p>
      <p class="text-base sm:text-lg max-w-2xl">
        I'm a marketing leader with 15+ years in content, positioning, UX, and go-to-market. Today
        I lead marketing activation for agent products at Zillow, after product marketing roles on
        Showcase and Bridge Interactive.
      </p>
      <p class="text-base sm:text-lg max-w-2xl">
        Focus areas: product marketing, go-to-market strategy, positioning and messaging, content
        strategy, sales enablement, and user experience for real estate technology.
      </p>
      <ul class="grid gap-2 text-sm text-[color:var(--muted)] max-w-2xl">
        <li class="flex items-start gap-3">
          <span class="icon-dot" aria-hidden="true"></span>
          <span>Translate technical products into customer-friendly stories.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="icon-dot" aria-hidden="true"></span>
          <span>Build positioning, messaging, and enablement that teams can actually use.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="icon-dot" aria-hidden="true"></span>
          <span>Shape launch plans with clear product narratives and outcomes.</span>
        </li>
      </ul>
      <div class="flex flex-wrap gap-4">
        <a class="btn btn-primary" href={SITE.ctaPrimary}>Schedule a Strategy Audit</a>
      </div>
      </div>
      <div class="flex justify-center lg:justify-end">
        <div class="portrait-frame">
          <img src="/joel.jpg" alt="Joel Burslem" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="ticker-wrap" aria-label="Trusted by">
    <div class="container">
      <span class="kicker">Trusted by</span>
      <div class="ticker">
        <div class="ticker-track">
      <span class="ticker-item">Zillow</span>
      <span class="ticker-item">WFG</span>
      <span class="ticker-item">1000watt</span>
      <span class="ticker-item">Sotheby's</span>
      <span class="ticker-item">Bright MLS</span>
      <span class="ticker-item">Inman News</span>
      <span class="ticker-item">Zillow</span>
      <span class="ticker-item">WFG</span>
      <span class="ticker-item">1000watt</span>
      <span class="ticker-item">Sotheby's</span>
      <span class="ticker-item">Bright MLS</span>
      <span class="ticker-item">Inman News</span>
        </div>
      </div>
    </div>
  </section>

  <section id="assets" class="container section grid gap-12">
    <div class="reveal grid gap-6">
      <span class="kicker">Distinctive Assets</span>
      <h2 class="serif text-3xl sm:text-4xl">Clear marketing, grounded in product reality.</h2>
      <p class="text-base sm:text-lg text-[color:var(--muted)] max-w-3xl">
        My work sits at the intersection of marketing, content, and product. I focus on clarity,
        credibility, and momentum.
      </p>
    </div>
    <div class="reveal grid sm:grid-cols-3 gap-6">
      <div class="p-6 rounded-2xl border border-[color:var(--line)] bg-[color:var(--bg-elev)]">
        <span class="tag">Brevity</span>
        <h3 class="serif text-2xl mt-4">Remarkable signals</h3>
        <p class="text-sm mt-3 text-[color:var(--muted)]">
          Short, memorable insights that make the value easy to repeat.
        </p>
      </div>
      <div class="p-6 rounded-2xl border border-[color:var(--line)] bg-[color:var(--bg-elev)]">
        <span class="tag">Rigor</span>
        <h3 class="serif text-2xl mt-4">Insight-backed moves</h3>
        <p class="text-sm mt-3 text-[color:var(--muted)]">
          Strategy rooted in outcomes, not opinions.
        </p>
      </div>
      <div class="p-6 rounded-2xl border border-[color:var(--line)] bg-[color:var(--bg-elev)]">
        <span class="tag">Clarity</span>
        <h3 class="serif text-2xl mt-4">Creative briefs, not jargon</h3>
        <p class="text-sm mt-3 text-[color:var(--muted)]">
          Plain language that keeps teams aligned and customers engaged.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
